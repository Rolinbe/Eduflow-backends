generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  APPRENANT
}

enum UserStatus {
  ACTIF
  INACTIF
  BLOQUE
}

enum CoursStatus {
  PUBLIE
  BROUILLON
  ARCHIVE
}

enum ProgressionStatus {
  NON_VU
  EN_COURS
  TERMINE
}

enum NotificationType {
  INFO
  SUCCES
  WARNING
  ERROR
  CERTIFICAT
  ANNONCE
}

enum CertificateStatus {
  VALIDE
  REVOQUE
}

enum Niveau {
  SIXIEME
  CINQUIEME
  QUATRIEME
  TROISIEME
  SECONDE
  PREMIERE
  TERMINALE
}

enum Serie {
  S
  L
  OSE
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String     @map("first_name") @db.VarChar(100)
  lastName  String     @map("last_name") @db.VarChar(100)
  email     String     @unique @db.VarChar(255)
  password  String     @db.VarChar(255)
  role      UserRole   @default(APPRENANT)
  status    UserStatus @default(ACTIF)
  niveau    Niveau?
  serie     Serie?
  avatar    String?    @db.VarChar(500)
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  cours         Cours[]
  enrollments   Enrollment[]
  progressions  Progression[]
  commentaires  Commentaire[]
  likes         Like[]
  notifications Notification[]
  certificates  Certificate[]
  auditLogs     AuditLog[]
  announcements Announcement[]

  conversations1 Conversation[] @relation("ConversationParticipant1")
  conversations2 Conversation[] @relation("ConversationParticipant2")
  sentMessages   Message[]      @relation("MessageSender")

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  cours Cours[]

  @@map("categories")
}

model Cours {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(255)
  description String?     @db.Text
  coverImage  String?     @map("cover_image") @db.VarChar(500)
  status      CoursStatus @default(BROUILLON)
  categoryId  Int?        @map("category_id")
  adminId     Int         @map("admin_id")
  niveau      Niveau?
  serie       Serie?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  admin        User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  videos       Video[]
  pdfs         PDF[]
  modules      Module[]
  enrollments  Enrollment[]
  progressions Progression[]
  commentaires Commentaire[]
  certificates Certificate[]

  @@map("cours")
}

model Video {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  url          String   @db.VarChar(500)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  duration     Int      @default(0)
  position     Int      @default(0)
  isRequired   Boolean  @default(true) @map("is_required")
  courseId     Int      @map("course_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cours Cours @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model PDF {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  url         String   @db.VarChar(500)
  pageCount   Int      @default(0) @map("page_count")
  position    Int      @default(0)
  courseId    Int      @map("course_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cours Cours @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("pdfs")
}

model Module {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  position  Int      @default(0)
  courseId  Int      @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  cours   Cours    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  type      String   @default("video") @db.VarChar(50)
  videoUrl  String?  @map("video_url") @db.VarChar(500)
  content   String?  @db.Text
  duration  Int      @default(0)
  position  Int      @default(0)
  moduleId  Int      @map("module_id")
  createdAt DateTime @default(now()) @map("created_at")

  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressions Progression[]
  commentaires Commentaire[]

  @@map("lessons")
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  courseId   Int      @map("course_id")
  progress   Int      @default(0)
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cours Cours @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Progression {
  id           Int               @id @default(autoincrement())
  userId       Int               @map("user_id")
  coursId      Int               @map("cours_id")
  lessonId     Int?              @map("lesson_id")
  status       ProgressionStatus @default(NON_VU)
  timeSpent    Int               @default(0) @map("time_spent")
  position     Int               @default(0)
  lastAccessed DateTime?         @map("last_accessed")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cours  Cours   @relation(fields: [coursId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@map("progressions")
}

model Commentaire {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  userId    Int      @map("user_id")
  coursId   Int      @map("cours_id")
  lessonId  Int?     @map("lesson_id")
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cours   Cours         @relation(fields: [coursId], references: [id], onDelete: Cascade)
  lesson  Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  parent  Commentaire?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Commentaire[] @relation("CommentReplies")
  likes   Like[]

  @@map("commentaires")
}

model Like {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  commentaireId Int      @map("commentaire_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentaire Commentaire @relation(fields: [commentaireId], references: [id], onDelete: Cascade)

  @@unique([userId, commentaireId])
  @@map("likes")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType @default(INFO)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Certificate {
  id              Int               @id @default(autoincrement())
  userId          Int               @map("user_id")
  coursId         Int               @map("cours_id")
  uniqueNumber    String            @unique @map("unique_number") @db.VarChar(50)
  verificationKey String            @map("verification_key") @db.VarChar(255)
  status          CertificateStatus @default(VALIDE)
  issuedAt        DateTime          @default(now()) @map("issued_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cours Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@unique([userId, coursId])
  @@map("certificates")
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id             Int      @id @default(autoincrement())
  participant1Id Int      @map("participant1_id")
  participant2Id Int      @map("participant2_id")
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  participant1 User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participant1Id, participant2Id])
  @@map("conversations")
}

model Message {
  id             Int           @id @default(autoincrement())
  conversationId Int           @map("conversation_id")
  senderId       Int           @map("sender_id")
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  content   String   @db.Text
  adminId   Int      @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("announcements")
}
